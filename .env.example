# =============================================================================
# Proxmox AI Infra Demo - configuration
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# false = fully mocked demo (no Proxmox, no Terraform execution, no internet)
# true  = real Proxmox API + real OpenTofu/Terraform runs
LIVE_MODE=false
# Name recorded in the history when AUTH_MODE=none
APP_USER=demo-operator

# --- Sign-in (docs/authentication.md) -----------------------------------------
# none = no login, everyone has every role (localhost demo only)
# oidc = Authentik, Microsoft Entra ID, AD FS, Keycloak   ldap = Active Directory, OpenLDAP, Authentik LDAP outpost
AUTH_MODE=none
AUTH_PROVIDER_NAME=
# Groups per role, separated by ";" (names, DNs or Entra object IDs). Approver includes operator includes viewer.
AUTH_VIEWER_GROUPS=
AUTH_OPERATOR_GROUPS=
AUTH_APPROVER_GROUPS=
# Production changes must be approved by someone other than the requester
AUTH_FOUR_EYES=true
AUTH_SESSION_HOURS=8
# Address users open in the browser (OIDC redirect URI = PUBLIC_URL/api/auth/callback). HTTPS in production.
PUBLIC_URL=https://console.example.internal
# Leave true behind HTTPS; false only for a plain-HTTP lab
AUTH_COOKIE_SECURE=true
# OIDC (client secret: secrets/oidc_client_secret)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
# LDAP (bind password: secrets/ldap_bind_password). TLS is required: ldaps:// or LDAP_START_TLS=true.
LDAP_URL=
LDAP_START_TLS=false
# Internal CA for the directory certificate: put it in ./certs/ and point here
LDAP_CA_FILE=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# AD: short name or UPN; OpenLDAP: (uid={username}) + uid; Authentik outpost: (cn={username}) + cn
LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={username})(userPrincipalName={username})))
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_GROUP_ATTRIBUTE=memberOf
# Active Directory only (nested groups); false for OpenLDAP and the Authentik LDAP outpost
LDAP_NESTED_GROUPS=true
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# --- Ports --------------------------------------------------------------------
FRONTEND_PORT=8080
# 127.0.0.1 = only through a reverse proxy on this host (recommended: it terminates HTTPS).
# 0.0.0.0 only with AUTH_MODE=oidc/ldap and HTTPS in front.
FRONTEND_BIND=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Proxmox VE API (API token auth only, never root) -----------------------
PROXMOX_HOST=pve.example.internal
PROXMOX_PORT=8006
PROXMOX_USER=automation@pve
PROXMOX_TOKEN_ID=infra-demo
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Set to false only for a self-signed lab certificate
PROXMOX_VERIFY_SSL=true
PROXMOX_NODE=pve

# --- Placement per environment ----------------------------------------------
TEST_STORAGE=local-lvm
TEST_BRIDGE=vmbr0
TEST_VLAN=30
PROD_STORAGE=local-lvm
PROD_BRIDGE=vmbr0
PROD_VLAN=10
# Optional: datastore with "snippets" content for cloud-init vendor data (guest agent + packages).
# Uploading snippets needs SSH to the node (PROXMOX_SSH_* below). Empty = disabled.
SNIPPETS_DATASTORE=
# Resource pool for templates and VMs (created by infra/scripts/bootstrap.sh). Empty = none.
POOL_ID=

# --- IaC ----------------------------------------------------------------------
# tofu (installed in the backend image) or terraform (build with TERRAFORM_VERSION)
IAC_BINARY=tofu

# --- Cloud-init templates -----------------------------------------------------
TEMPLATE_UBUNTU_2404_ID=9000
TEMPLATE_DEBIAN_12_ID=9001
# Windows has no redistributable cloud image: provide this template once (docs/windows-template.md)
TEMPLATE_WINDOWS_2022_ID=9002
TEMPLATE_STORAGE=local-lvm
# Storage with content type "import" for cloud images (bootstrap creates "infra-demo")
IMAGE_STORAGE=local
# Official cloud images: the platform stack (Prepare Platform) downloads these and builds the templates
UBUNTU_2404_IMAGE_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
DEBIAN_12_IMAGE_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2
# LXC templates for stack containers (official Proxmox mirror; check `pveam available` for current versions)
DEBIAN_12_CT_URL=https://download.proxmox.com/images/system/debian-12-standard_12.7-1_amd64.tar.zst
UBUNTU_2404_CT_URL=https://download.proxmox.com/images/system/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
# Storage with content 'vztmpl' for those templates ('' = IMAGE_STORAGE; bootstrap enables vztmpl there)
CT_STORAGE=

# --- Cloud-init defaults ------------------------------------------------------
CI_USER=ops
# Public key only (ssh-ed25519 AAAA... user@host). Never a private key.
DEFAULT_SSH_PUBLIC_KEY=

# --- Software configuration (Ansible, docs/configuration.md) -----------------
# Private key for Linux VMs (public half = DEFAULT_SSH_PUBLIC_KEY). Prefer the Docker secret.
ANSIBLE_SSH_KEY_FILE=
# Windows Administrator password (12+ chars) for cloudbase-init + WinRM. Prefer the Docker secret.
WINDOWS_ADMIN_PASSWORD=
# Project software: folder with Ansible roles + profile.yml, mounted at /profiles (see profiles/README.md)
PROFILES_DIR=./profiles
# Comma-separated packages nobody may install through the console (users or AI)
PACKAGE_DENYLIST=telnetd,rsh-server
# Optional node SSH access for snippet uploads
PROXMOX_SSH_USERNAME=
PROXMOX_SSH_PRIVATE_KEY_FILE=

# --- Validation ---------------------------------------------------------------
VALIDATION_TIMEOUT_SECONDS=300
# Mock mode only: force every validation to fail (for the troubleshooting demo)
MOCK_FAIL_VALIDATION=false
# Mock mode only: start with the Linux templates already built (skip "Prepare Platform")
MOCK_PLATFORM_READY=false

# --- AI -------------------------------------------------------------------------
# anthropic or none. With none (or no key) a deterministic local fallback is used.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_TOKENS=4000
