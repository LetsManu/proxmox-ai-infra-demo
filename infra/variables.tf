variable "environment" {
  description = "test or prod. Selects policy from environments/<env>.tfvars."
  type        = string

  validation {
    condition     = contains(["test", "prod"], var.environment)
    error_message = "environment must be \"test\" or \"prod\"."
  }
}

variable "node_name" {
  description = "Proxmox node name."
  type        = string
  default     = "pve"
}

variable "datastore_id" {
  description = "Storage pool for VM disks in this environment."
  type        = string
  default     = "local-lvm"
}

variable "bridge" {
  description = "Network bridge for this environment."
  type        = string
  default     = "vmbr0"
}

variable "vlan_id" {
  description = "VLAN tag for this environment (0 = untagged)."
  type        = number
  default     = 0
}

variable "vm_id_min" {
  description = "Lowest VM ID for this environment."
  type        = number
}

variable "vm_id_max" {
  description = "Highest VM ID for this environment."
  type        = number
}

variable "max_cores" {
  description = "Policy limit: vCPU per VM."
  type        = number
}

variable "max_memory_mb" {
  description = "Policy limit: memory per VM in MB."
  type        = number
}

variable "max_disk_gb" {
  description = "Policy limit: disk per VM in GB."
  type        = number
}

variable "full_clone" {
  description = "Use full clones (prod) or linked clones (test)."
  type        = bool
}

variable "start_on_boot" {
  description = "Start VMs when the node boots."
  type        = bool
  default     = false
}

variable "base_tags" {
  description = "Tags added to every VM in this environment."
  type        = list(string)
  default     = []
}

variable "ci_user" {
  description = "Cloud-init default user."
  type        = string
  default     = "ops"
}

variable "default_ssh_public_key" {
  description = "Public key used when a VM does not specify one."
  type        = string
  default     = ""
}

variable "snippets_datastore_id" {
  description = "Datastore for cloud-init snippets ('' disables package installs via snippets)."
  type        = string
  default     = ""
}

variable "vms" {
  description = "VMs in this environment, keyed by name. Generated by the backend from its database."
  type = map(object({
    vm_id          = number
    template_id    = number
    cores          = number
    memory_mb      = number
    disk_gb        = number
    description    = optional(string, "")
    ssh_public_key = optional(string, "")
    tags           = optional(list(string), [])
    packages       = optional(list(string), [])
    commands       = optional(list(string), [])
  }))
  default = {}

  validation {
    condition     = alltrue([for k, _ in var.vms : can(regex("^[a-z][a-z0-9-]{1,40}[a-z0-9]$", k))])
    error_message = "VM names must be lowercase letters, digits and hyphens."
  }
}
